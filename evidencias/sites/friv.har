            "size": 5060,
            "text": "console.log(\"=== pt-jokes.js LOADED\");\r\n\r\n//looked over by native speaker...\r\n\r\nwindow.todaysJoke = \"A Piada de Hoje\"; // Today's Joke\r\nwindow.randomJoke = \"Piada Aleatória\"; // Random Joke\r\nwindow.todaysValentinesJoke = \"Piada de Dia dos Namorados de Hoje\"; // Today's Valentine's Joke\r\nwindow.todaysEasterJoke = \"Piada de Páscoa de Hoje\"; // Today's Easter Joke\r\nwindow.todaysHalloweenJoke = \"Piada de Halloween de Hoje\"; // Today's Halloween Joke\r\nwindow.todaysChristmasJoke = \"Piada de Natal de Hoje\"; // Today's Christmas Joke\r\nwindow.randomValentinesJoke = \"Piada Aleatória de Dia dos Namorados\"; // Random Valentine's Joke\r\nwindow.randomEasterJoke = \"Piada Aleatória de Páscoa\"; // Random Easter Joke\r\nwindow.randomHalloweenJoke = \"Piada Aleatória de Halloween\"; // Random Halloween Joke\r\nwindow.randomChristmasJoke = \"Piada Aleatória de Natal\"; // Random Christmas Joke\r\nwindow.clickForAnswer = \"Clique para a Resposta\"; // Click For The Answer\r\nwindow.tapForAnswer = \"Toque para a Resposta\"; //Tap For The Answer\r\nwindow.scriptWarning = \"Desculpe. Pode haver um problema com sua conexão ou seu navegador. Algo bloqueou o acesso a partes desta página. Verifique se você está usando um navegador atualizado e certifique-se de desativar quaisquer extensões que possam bloquear elementos interativos. Em seguida, recarregue. Nenhum dos jogos no Friv contém anúncios. :)\";\r\n// Sorry. There may be an issue with your connection or your browser. Something blocked access to parts of this page. Please check that you are using an up to date browser, and be sure to turn off any extensions that may block interactive elements. Then reload. None of the games on Friv contain ads. :)\r\nwindow.didYouKnowOpener = \"Você sabia...\"; // Did you know...\r\nwindow.jokeVotingThankyou = \"Obrigado!\" //Thank you!\r\n\r\n//ChatGPT + Grok (real jokes) checked by Gemini\r\n//upvoted...\r\nwindow.valentinesJokes = [\r\n    [\"Qual é a sobremesa favorita dos casais?\", \"O beijinho!\"],\r\n    [\"Qual é o amor que dói?\", \"AMordida!\"],\r\n    [\"Amor, você é como a caspa. Por qual motivo?\", \"Porque eu simplesmente não consigo tirar você da minha cabeça!\"],\r\n    [\"Por que o casal levou uma escada para o encontro?\", \"Porque o amor deles estava nas alturas!\"],\r\n    [\"Você não é Wi-Fi, mas o que aconteceu?\", \"Conectou direto no meu coração!\"],\r\n    [\"Você acredita em amor à primeira vista?\", \"Então, espera que vou passar de novo e você me diz!\"],\r\n    //backup...\r\n    //[\"Qual é o amor que serve de descanso?\", \"AMoradia!\"],\r\n    //[\"O nosso amor não foi amor à primeira vista por qual razão?\", \"Porque somos míopes!\"]\r\n];\r\n\r\n//upvoted...\r\nwindow.easterJokes = [\r\n    [\"Qual é o jogo favorito do coelho de Páscoa?\", \"Caça aos ovos!\"],\r\n    [\"Como se chama um coelho que ganhou na lotaria?\", \"Um coelhionário!\"],\r\n    [\"O que é que o coelhinho da Páscoa foi fazer ao ginásio?\", \"EGGercício!\"],\r\n    [\"Por que é que o coelhinho da Páscoa não faz dieta?\", \"Porque ele está sempre a saltar refeições!\"],\r\n    [\"Você sabe por que o saco do Coelho da Páscoa vive cheio de formigas?\", \"É porque os ovos são de chocolate!\"],\r\n    [\"Qual é o filme favorito do coelho de Páscoa?\", \"Em busca do ovo perdido!\"],\r\n    //[\"Que tipo de coelho uma raposa não come?\", \"Um coelho de chocolate!\"],\r\n    //[\"O que é que o ovo de chocolate disse ao coelho?\", \"Não me chateies, que eu já estou recheado de problemas!\"],\r\n];\r\n\r\nwindow.halloweenJokes = [];\r\n\r\n//Best of ChatGPT and Grok 2025-11-25 (sounded credible) Gemini checked\r\nwindow.christmasJokes = [\r\n    //21 pt xmas jokes voted 1 or above\r\n    [\"Sou redonda e adoro lá estar?\", \"Bola de Natal!\"],\r\n    [\"Qual é o cereal favorito do boneco de neve?\", \"Flocos de neve!\"],\r\n    [\"Como você assusta um boneco de neve?\", \"Mostra-lhe um secador de cabelo!\"],\r\n    [\"Qual a diferença entre o boneco de neve e a boneca de neve?\", \"As bolas de neve!\"],\r\n    [\"Onde é que o Pai Natal fica nas férias?\", \"Num ho-ho-hotel!\"],\r\n    [\"Pelo que aprendem os duendes?\", \"Pelo Elfabeto!\"],\r\n    [\"Quem vem do Polo‑Norte é o quê?\", \"É polo‑nortista!\"],\r\n    [\"O que é um pontinho vermelho descendo uma ladeira rapidamente?\", \"O Papai Noel descendo o morro!\"],\r\n    [\"Quem nunca fica com fome no Natal?\", \"O peru, que é sempre servido cheio!\"],\r\n    [\"Por que os elfos se sentem feios?\", \"Porque eles têm baixa elfo‑estima!\"],\r\n    [\"Sabe quando você percebe que cresceu?\", \"Quando fica mais animado pela comida do que pelos presentes!\"],\r\n    [\"Sabe qual o nome do homem que monta o presépio de Natal?\", \"Armando Nascimento de Jesus!\"],\r\n    [\"Você vai me dar o quê de presente de Natal?\", \"Nada, ué! O aniversário não é seu, é de Jesus!\"],\r\n    [\"Onde eu vou estar esse ano?\", \"Embaixo da sua árvore de Natal, porque sou o presente que você sempre sonhou!\"],\r\n    [\"De nada adianta pedir o presente perfeito para o Papai Noel\", \"Eu não caibo dentro do saco!\"],\r\n    [\"O que bonecos de neve fazem quando ficam bravos com você?\", \"Te dão um gelo!\"],\r\n    [\"Quantos presentes o Papai Noel consegue colocar em uma sacola vazia?\", \"Apenas um, depois disso a sacola não está mais vazia!\"],\r\n    [\"Por que as renas sempre voam por cima das montanhas?\", \"Porque elas não podem passar por baixo!\"],\r\n    [\"Qual a semelhança entre o Rio Grande do Norte e o fim do ano?\", \"Ambos têm Natal!\"],\r\n    [\"Qual o tipo de música favorita do Papai Noel?\", \"É o “Rock rou, rou, rou”!\"],\r\n    [\"Como o Papai Noel se comunica com suas renas?\", \"Ele usa um smart‑renó‑fone!\"],\r\n\r\n    /* backup pt xmas jokes, voted 0.7 or above\r\n    [\"Tenho cor cinzenta, não sou rena e aqueço o menino?\", \"O burro!\"],\r\n    [\"Estou muito embrulhadinho e enfeitado com um laço?\", \"Presente!\"],\r\n    [\"À noite no céu me coloco para que me vejam a brilhar?\", \"Estrela!\"],\r\n    [\"Minha cor é sempre o verde, no inverno e no verão?\", \"Árvore de Natal!\"],\r\n    [\"Este meio de transporte funciona no Natal para trazer às crianças uma prenda especial?\", \"Trenó!\"],\r\n    [\"Sou uma guloseima doce e cheia de frutinhas, comida, especialmente, no Natal?\", \"Rabanada!\"],\r\n    [\"O que diz um boneco de neve para o outro?\", \"Não achas que hoje cheira a cenoura!\"],\r\n    [\"Por que o boneco de neve estava sorrindo?\", \"Porque estava a derreter!\"],\r\n    [\"O que os bonecos de neve usam na cabeça?\", \"Chapéus de gelo!\"],\r\n    [\"Qual é o fenómeno meteorológico mais comum no Natal?\", \"É a rabanada de vento!\"],\r\n    [\"O que é uma bola vermelha e branca, vermelha e branca, vermelha e branca?\", \"O Pai Natal a rolar por uma montanha abaixo!\"],\r\n    [\"Por que o peru usa máscara no Natal?\", \"Porque é peruibido!\"],\r\n    [\"Quem faz a festa no Natal?\", \"O peru, mas a missa é do galo!\"],\r\n    [\"Por que é dezembro tão frio?\", \"Porque é Dezembrrrrrrro!\"],\r\n    [\"O que é um pontinho vermelho na neve?\", \"Uma pimenta congelada!\"],\r\n    [\"O que você ganha quando cruza um boneco de neve e um cachorro?\", \"Frosty o snow-dog!\"],\r\n    [\"Onde os bonecos de neve guardam seu dinheiro?\", \"Em um banco de neve!\"],\r\n    [\"O que acontece quando você cruza um vampiro e um boneco de neve?\", \"Queimadura de frio!\"],\r\n    [\"Como chamamos quem não acredita no Papai Noel?\", \"Des‑natal‑rado!\"],\r\n    [\"O que nunca pode ser colocado dentro da panela enquanto você prepara a ceia de Natal?\", \"A tampa!\"],\r\n    [\"Por que o boneco de neve cruzou a rua?\", \"Para derreter do outro lado!\"],\r\n    [\"Quem é o pior presente de Natal pra mim?\", \"É aquele tio que conta piadas do pavê!\"],\r\n    [\"O que é, o que é, que viaja o mundo todo como o Papai Noel, mas não sai do seu canto?\", \"O selo!\"],\r\n    [\"Quando o Papai Noel sai do Polo Norte na véspera do Natal, para que direção ele vai?\", \"Para o Sul, pois tudo está a sul do Polo Norte!\"],\r\n    [\"Por que o Papai Noel é conhecido como Noel Peso‑Pesado?\", \"Porque ele sempre chega cheio de presentes!\"],\r\n    */\r\n];\r\n\r\n//upvoted 31/01/2026 ratio 1.2 or higher\r\nwindow.topDailyJokes = [\r\n    [\"O que tem boca, mas não fala; tem leito, mas não dorme; e corre, mas não anda?\", \"Um rio!\"],\r\n    [\"Doutor, doutor, toda vez que eu vejo um quadro, as pinturas ganham vida! Interessante! Você tem uma imaginação incrível! Continue sonhando!\"],\r\n    [\"O que tem coroa, mas não é rei; tem folhas, mas não é árvore; e usa chapéu, mas não tem cabeça?\", \"Um abacaxi!\"],\r\n    [\"O que o tomate foi fazer no banco? Tirar extrato!\"],\r\n    [\"O que tem sempre perguntas, mas nunca dá palpites?\", \"Um questionário!\"],\r\n    [\"O que tem escamas, mas não é peixe?\", \"Uma pinha!\"],\r\n    [\"O que sobe, mas nunca desce?\", \"Sua idade!\"],\r\n    [\"O que tem um olho, mas não vê?\", \"Uma agulha!\"],\r\n    [\"O que sobe e desce sem se mexer?\", \"A escada!\"],\r\n    [\"O que tem pescoço, mas não tem cabeça; tem corpo, mas não tem pernas; e pode te contar uma história?\", \"Um livro!\"],\r\n    [\"A geladeira adora contar histórias de congelar o coração.\"],\r\n    [\"O que fica molhado quanto mais se seca?\", \"Uma toalha!\"],\r\n    [\"O astronauta não gosta de fofocas porque são coisas de outro mundo.\"],\r\n    [\"O que está sempre vindo, mas nunca chega?\", \"O amanhã!\"],\r\n    [\"O que tem dentes, mas não pode morder?\", \"Um pente!\"],\r\n    [\"O pão não entende piadas, ele é francês.\"],\r\n    [\"O gelo não gosta de fofoca porque se derrete fácil.\"],\r\n    [\"A galinha adora festa porque vive botando pra quebrar.\"],\r\n    [\"O que tem que chover para se poder varrer?\", \"Folhas!\"],\r\n    [\"O que tem voz, mas não fala?\", \"Um eco!\"],\r\n    [\"O que tem dentes, mas não come?\", \"Um pente!\"],\r\n    [\"O que é que tem cidades, mas não tem casas; tem montanhas, mas não tem pedras; e tem água, mas não tem peixes?\", \"Um mapa!\"],\r\n    [\"O que fica maior quanto mais se tira?\", \"Um buraco!\"],\r\n    [\"O que fica cheio de buracos, mas continua segurando água?\", \"Uma esponja!\"],\r\n    [\"O livro de matemática está triste porque tem muitos problemas.\"],\r\n    [\"Por que o livro foi ao médico?\", \"Porque estava cheio de problemas!\"],\r\n    [\"Por que a matemática ficou triste?\", \"Porque tinha muitos problemas!\"],\r\n    [\"O que o peixe falou para o outro peixe?\", \"Nada!\"],\r\n    [\"Por que o computador foi ao médico?\", \"Porque pegou um vírus!\"],\r\n    [\"Por que o cachorro entrou na igreja?\", \"Porque era um pastor alemão!\"],\r\n    [\"O que a vaca foi fazer no espaço?\", \"Ver a Via Láctea!\"],\r\n    [\"Por que o gato mia para o computador?\", \"Porque quer acessar o mouse!\"],\r\n    [\"Por que o elefante não usa computador?\", \"Porque tem medo do mouse!\"],\r\n    [\"O que a abelha faz no ginásio?\", \"Zum-ba!\"],\r\n    [\"Por que o peixe não gosta de computador?\", \"Porque tem medo da rede!\"],\r\n    [\"Por que o relógio foi ao psicólogo?\", \"Porque tinha tiques!\"],\r\n    [\"Por que o relógio dorme cedo?\", \"Para acordar na hora certa!\"],\r\n    [\"O que a porta falou para a chave?\", \"Você me abre!\"],\r\n    [\"O que o gato faz na internet?\", \"Navega no mouse!\"],\r\n    [\"Por que o lápis ficou bravo?\", \"Porque foi apontado demais!\"],\r\n    [\"Por que o relógio gosta de correr?\", \"Para ganhar tempo!\"],\r\n    [\"O que a vaca falou para o espelho?\", \"Estou muuuito bonita!\"],\r\n    [\"Por que o relógio ficou nervoso?\", \"Porque perdeu a hora!\"],\r\n    [\"O que uma pulga disse à outra?\", \"Vamos saltar fora daqui!\"],\r\n    [\"O que é um pontinho preto no avião?\", \"Uma aeromosca!\"],\r\n    [\"Qual é o animal mais antigo do mundo?\", \"A zebra, porque está a preto e branco!\"],\r\n    [\"Qual é o rei dos queijos?\", \"O Requeijão!\"],\r\n    [\"O que a impressora disse para a outra?\", \"Essa folha é tua ou é impressão minha?!\"],\r\n    [\"Qual é o animal que anda com os pés na cabeça?\", \"O piolho!\"],\r\n    [\"O que é que atravessa o rio e não se molha?\", \"A ponte!\"],\r\n    [\"O que é que de dia tem quatro pernas e de noite tem seis?\", \"A cama!\"],\r\n    [\"O que é que entra na água e não se molha?\", \"A sombra!\"],\r\n    [\"Qual é o super-herói que passa roupa?\", \"O Homem de Ferro!\"],\r\n    [\"O que o fantasma disse ao outro?\", \"Você acredita em gente?!\"],\r\n    [\"Por que os pássaros voam para o sul no inverno?\", \"Porque é muito longe a pé!\"],\r\n    [\"O que o milho disse para a manteiga?\", \"Não me derretas!\"],\r\n    [\"O que o martelo disse para o prego?\", \"Vamos bater um papo!\"],\r\n    [\"Qual é o animal que bebe com o rabo?\", \"Todos, nenhum tira o rabo para beber!\"],\r\n    [\"O que o sol disse para a lua?\", \"Você é ofuscante!\"],\r\n    [\"O que uma chave disse para a fechadura?\", \"Encaixamos bem!\"],\r\n    [\"Médico, médico, acho que sou invisível! Quem falou?\"],\r\n    [\"Toc, toc! Quem é? É o Caio! Que Caio? Caio fora!\"],\r\n    [\"O que a vaca disse para o bezerro?\", \"Muuuito bem!\"],\r\n    [\"O que a lua disse para o sol?\", \"Você brilha demais!\"],\r\n    [\"Por que o lápis foi para a escola?\", \"Para aprender a escrever melhor!\"],\r\n\r\n    /*\r\n    backup jokes upvoted ratio 1.1\r\n    [\"O pão não tem tempo ruim, ele sempre está na chapa.\"],\r\n    [\"O que tem sempre folhas, mas não é uma árvore?\", \"Um livro!\"],\r\n    [\"Médico, médico, estou com dor aqui! Então não toque aí!\"],\r\n    [\"Médico, médico, tenho dor de cabeça! Isso é de tanto pensar!\"],\r\n    [\"O que uma pulga disse à outra?\", \"Vamos a pé ou esperamos pelo cão?!\"],\r\n    [\"O que a parede disse para a outra?\", \"A gente se encontra na esquina!\"],\r\n    [\"O que o fogo disse para a água?\", \"Vamos apagar isto!\"],\r\n    [\"Doutor, doutor, acho que sou um super-herói! Interessante! Que tipo de superpoder você tem?\"],\r\n    [\"Por que o livro foi ao dentista?\", \"Porque tinha páginas sensíveis!\"],\r\n    [\"Qual é o animal mais feliz?\", \"O grilo, porque está sempre a cantar!\"],\r\n    [\"Por que o polvo é bom em matemática?\", \"Porque tem muitos braços para contar!\"]\r\n    */\r\n];"
