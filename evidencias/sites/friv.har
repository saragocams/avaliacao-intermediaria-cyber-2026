lative;\r\n            background-color: #80d;\r\n            cursor: pointer;\r\n        }\r\n\r\n        #amazingImage {\r\n            position: relative;\r\n            height: 100vh;\r\n            background-color: #80d;\r\n            background-repeat: no-repeat;\r\n            background-size: contain;\r\n            background-position: center;\r\n            display: none;\r\n        }\r\n\r\n        #amazingImageBottomBar {\r\n            position: relative;\r\n            min-height: 5vh;\r\n            background-color: #80d;\r\n            padding-bottom: 2vh;\r\n            font-size: 4em;\r\n            display: none;\r\n            margin-top: -0.2vh;\r\n        }\r\n\r\n        #streetArt {\r\n            position: relative;\r\n            background-color: #a0b;\r\n            cursor: pointer;\r\n        }\r\n\r\n        #streetArtImage {\r\n            position: relative;\r\n            height: 100vh;\r\n            background-color: #a0b;\r\n            background-repeat: no-repeat;\r\n            background-size: contain;\r\n            background-position: center;\r\n            display: none;\r\n        }\r\n\r\n        #streetArtBottomBar {\r\n            position: relative;\r\n            min-height: 5vh;\r\n            background-color: #a0b;\r\n            padding-bottom: 2vh;\r\n            font-size: 4em;\r\n            display: none;\r\n            margin-top: -0.2vh;\r\n        }\r\n\r\n        #opticalIllusion {\r\n            position: relative;\r\n            background-color: #65d;\r\n            cursor: pointer;\r\n        }\r\n\r\n        #opticalIllusionImage {\r\n            position: relative;\r\n            height: 100vh;\r\n            background-color: #65d;\r\n            background-repeat: no-repeat;\r\n            background-size: contain;\r\n            background-position: center;\r\n            cursor: pointer;\r\n            display: none;\r\n        }\r\n\r\n        #opticalIllusionBottomBar {\r\n            posit