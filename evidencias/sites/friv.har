rait#puzzle#word\"], //Guess-Word shg/guessword/index.html\r\n                [\"SGV4YS1Xb3Jk\", \"c2hnL2hleGF3b3JkL2luZGV4Lmh0bWw=\", \"\", 0, \"!ftr!g!d!t#portrait#puzzle#word\"], //Hexa-Word shg/hexaword/index.html\r\n\r\n                //[\" xxx \", \" xxx \", \"\", 0, \"!ftr!g!d!t#portrait#puzzle\"], //Game-Name shg/---/index.html\r\n            );\r\n        }\r\n\r\n\r\n        //last\r\n        if (testVer) {\r\n            devoryGamesArray.push(\r\n                //[\"64-u\", \"64-u\", \"\", 0, \"!d!t!webp#landscape\"], //Game-Name www.yurk.com/games/xxx/\r\n            );\r\n\r\n        }\r\n\r\n\r\n\r\n        //any adjustments...\r\n\r\n        function consoleBreak() {\r\n\r\n            for (let i = 0; i < 9; i++) {\r\n                console.log(\" \");\r\n            }\r\n            for (let i = 0; i < 5; i++) {\r\n                console.log(\"##############\");\r\n            }\r\n            for (let i = 0; i < 9; i++) {\r\n                console.log(\" \");\r\n            }\r\n\r\n        }\r\n\r\n        consoleBreak();\r\n\r\n        //var devoryGamesArrayFinal;\r\n\r\n        function showDevoryGames(selectedGamesCategory) {\r\n\r\n            console.log(\"********************** selectedGamesCategory: \" + selectedGamesCategory);\r\n\r\n            var devoryGamesArrayFinal = devoryGamesArray;\r\n\r\n            console.log(\"=== devoryGamesArrayFinal === \" + devoryGamesArrayFinal.length)\r\n\r\n            var devoryGamesOutput = \"\";\r\n            var footerColor = \"\";\r\n            var link = \"\";\r\n            var gameThumbLoadingNumber = 0;\r\n            var devoryDefs = \"\";\r\n            var devoryDefsPass = \"\";\r\n            var devoryURLVarTemp = \"\";\r\n            var devoryURLArrayTemp1 = \"\";\r\n            var devoryURLArrayTemp2 = \"\";\r\n            var thumbsPath = \"z/thumbs/devorygames/\";\r\n            var devoryGamesCounter = 0;\r\n            var topStrap = \"\";\r\n            var lastElementIndex = 0;\r\n\r\n            if (devorySiteID != \"FDC\") {\r\n                thumbsPath = \"thumbs/\";\r\n            }\r\n\r\n            var i;\r\n            for (i = 0; i < devoryGamesArrayFinal.length; i++) {\r\n\r\n                if ((debug || testVer) && true) {\r\n\r\n                    console.log(\" \");\r\n\r\n                    devoryURLVarTemp = atob(devoryGamesArrayFinal[i][1]);\r\n\r\n                    console.log(\"Devory decoded name: \" + atob(devoryGamesArrayFinal[i][0]) + \" - \" + devoryGamesArrayFinal[i][0]);\r\n                    console.log(\"Devory decoded URL: \" + devoryURLVarTemp);\r\n\r\n                    //if url contains 2dans, will need further work...\r\n\r\n                    if (devoryURLVarTemp.indexOf(\"/gf.\") > -1) {\r\n                        //console.log(\"Is gf.html ...\");\r\n\r\n                        //console.log(devoryURLVarTemp + \" \" + devoryGamesArrayFinal[i][0]);\r\n\r\n                        devoryURLArrayTemp1 = devoryURLVarTemp.split(\"?\");\r\n\r\n                        //console.log(\"devoryURLArrayTemp1 \" + devoryURLArrayTemp1);\r\n\r\n                        devoryURLArrayTemp2 = devoryURLArrayTemp1[1].split(\",\");\r\n\r\n                        //console.log(\"devoryURLArrayTemp2 \" + devoryURLArrayTemp2);\r\n\r\n                        console.log(\"Devory twice decoded URL: \" + atob(devoryURLArrayTemp2[0]) + \" \" + atob(devoryGamesArrayFinal[i][0]) + \" \" + devoryGamesArrayFinal[i][0]);\r\n\r\n                        //devoryURLVarTemp = \r\n\r\n                    }\r\n\r\n                    //console.log(devoryURLArrayTemp[1]);\r\n                }\r\n\r\n\r\n\r\n                //lastElementIndex =  devoryGamesArrayFinal[i][devoryGamesArrayFinal[i].length - 1];\r\n\r\n                lastElementIndex = devoryGamesArrayFinal[i].length - 1;\r\n                console.log(lastElementIndex);\r\n\r\n\r\n                //devory desfs are always taken from the last element, regardless of array elements length\r\n                devoryDefs = devoryGamesArrayFinal[i][lastElementIndex];\r\n\r\n                //console.log(devoryDefs);\r\n\r\n\r\n\r\n                if (devoryDefs.indexOf(selectedGamesCategory) > -1 || selectedGamesCategory == \"all\") {\r\n\r\n                    console.log(\"!!!!!!!!!!!!!!!!!!!!!!!!!!\" + atob(devoryGamesArrayFinal[i][1]));\r\n\r\n                    if (devoryDefs.indexOf(\"!so\") == -1 || gamePlays > 1 || testVer) {\r\n\r\n                        if (((devoryDefs.indexOf(\"!2pk\") > -1 || devoryDefs.indexOf(\"!pg\") > -1) && showPack2) || (devoryDefs.indexOf(\"!3pk\") > -1 && showPack3) || (devoryDefs.indexOf(\"!2pk\") == -1 && devoryDefs.indexOf(\"!3pk\") == -1 && devoryDefs.indexOf(\"!pg\") == -1) || devorySiteID != \"FDC\" || testVer) {\r\n\r\n                            if ((shortLang == \"en\") || (devoryDefs.indexOf(\"!en\") == -1 && shortLang != \"en\")) {\r\n\r\n                                if ((devoryDefs.indexOf(\"!d\") > -1 && !touchDevice) || (devoryDefs.indexOf(\"!t\") > -1 && touchDevice) || testVer) {\r\n\r\n                                    if (devoryDefs.indexOf(\"!fgo\") == -1 || (devoryDefs.indexOf(\"!fgo\") > -1 && gfxPerformanceCategory >= 3)) {\r\n\r\n                                        //if(atob(devoryGamesArrayFinal[i][1]).indexOf(\"friv.com\") > -1) {\r\n                                        //   console.log(\"QQQ: This is a FDC game: \" + atob(devoryGamesArrayFinal[i][1]));\r\n                                        //   }\r\n\r\n                                        if ((atob(devoryGamesArrayFinal[i][1]).indexOf(\"friv.com\") == -1) || canAccessFDC) { //if game is not on FDC or \r\n\r\n                                            if (devoryDefs.indexOf(\"!nipn\") > -1 && os == \"iPadNew\") {\r\n                                                //no output for new ipad\r\n                                            } else {\r\n\r\n                                                var imageEnding = \"150x150Min.png\";\r\n\r\n                                                var secondImgClass = \"\"; //apply pixelated class to smaller images\r\n\r\n                                                if (devoryDefs.indexOf(\"!g\") > -1) {\r\n                                                    imageEnding = \".gif\";\r\n                                                }\r\n\r\n                                                if (devoryDefs.indexOf(\"!webp\") > -1) {\r\n                                                    imageEnding = \"150x150Min.webp\";\r\n                                                }\r\n\r\n                                                if (devoryDefs.indexOf(\"!p\") > -1) {\r\n                                                    secondImgClass = \"pixelated\";\r\n                                                }\r\n\r\n                                                footerColor = \"Clear\";\r\n\r\n                                                //console.log(\"gamePlays: \" + gamePlays);\r\n                                                //console.log(\"footerColor before: \" + footerColor);\r\n\r\n                                                if (devorySiteID == \"FDC\") {\r\n\r\n                                                    if ((gamePlays - 4 < startToShowPack2 || testVer) && (devoryDefs.indexOf(\"!pg\") > -1 || devoryDefs.indexOf(\"!2pk\") > -1)) {\r\n                                                        footerColor = \"Cyan\";\r\n                                                    }\r\n\r\n                                                    if ((gamePlays - 4 < startToShowPack3 || testVer) && (devoryDefs.indexOf(\"!3pk\") > -1)) {\r\n                                                        footerColor = \"Yellow\";\r\n                                                    }\r\n\r\n                                                    if ((specialPeriod == \"halloween\" || testVer) && devoryDefs.indexOf(\"#halloween\") > -1) {\r\n                                                        footerColor = \"Orange\";\r\n                                                    }\r\n\r\n                                                }\r\n\r\n                                                devoryDefsPass = \"#\";\r\n\r\n                                                if (devoryDefs.indexOf(\"!pg\") > -1) {\r\n                                                    devoryDefsPass = \"!pg\";\r\n                                                }\r\n\r\n                                                if (devoryDefs.indexOf(\"!en\") > -1) {\r\n                                                    devoryDefsPass += \"!en\";\r\n                                                }\r\n\r\n                                                //if (devoryDefs.length > 10) {\r\n                                                //    devoryDefsPass = \"#\";\r\n                                                //}\r\n\r\n                                                link = \"play.html?\" + devoryGamesArrayFinal[i][0] + \",\" + devoryGamesArrayFinal[i][1] + \",\" + devoryDefsPass;\r\n\r\n                                                if (link.indexOf(\"R2FtdWk=\") > -1) {\r\n                                                    link = \"https://www.gamui.com/\";\r\n                                                }\r\n\r\n                                                if (link.indexOf(\"WmVsZ2lybA==\") > -1) {\r\n                                                    link = \"https://www.zelgirl.com/\";\r\n                                                }\r\n\r\n                                                if (devoryDefs.indexOf(\"!direct\") > -1) {\r\n                                                    link = \"https://\" + window.atob(devoryGamesArrayFinal[i][1]);\r\n                                                }\r\n\r\n                                                if (devoryDefs.indexOf(\"!ftr\") > -1) {\r\n                                                    link = \"https://www.friv.tr/\" + window.atob(devoryGamesArrayFinal[i][1]);\r\n                                                }\r\n\r\n                                                if (devoryDefs.indexOf(\"!fac\") > -1) {\r\n                                                    link = \"https://www.frivace.com/\" + window.atob(devoryGamesArrayFinal[i][1]);\r\n                                                }\r\n\r\n                                                if (debug || testVer) {\r\n                                                    console.log(\"Devory link: \" + link);\r\n                                                }\r\n\r\n                                                devoryGamesOutput += \"<div class=gameThumbContainerMini> <div class=gameThumbShine></div> <div class=gameThumbGenColor\" + footerColor + \">\" + window.atob(devoryGamesArrayFinal[i][0]).replace(/-/g, \" \") + \"</div><a href='\" + link + \"'><img width='150' height='150' loading='lazy' class='gameThumb \" + secondImgClass + \"' src='\" + thumbsPath + window.atob(devoryGamesArrayFinal[i][0]).replace(/,/g, \"\").replace(/-/g, \"\").replace(/!/g, \"\").replace(/[?=]/g, \"\").replace(/'/g, \"\").replace(/ñ/g, \"n\").replace(/\\./g, \"\").toLowerCase() + imageEnding + \"'onmouseover='japSound()' alt='\" + window.atob(devoryGamesArrayFinal[i][0]) + \"'></a></div>\";\r\n\r\n                                                devoryGamesCounter++;\r\n\r\n                                            } //iPadNew check\r\n\r\n                                        } //can access FDC\r\n\r\n                                    } //fgo\r\n\r\n                                } //device check\r\n\r\n                            } //en-language check\r\n\r\n                        } //nostalgia games etc. (mostly old emulated Flash games, games 20+ years old)\r\n\r\n                    } //so\r\n\r\n                } //categories\r\n\r\n            }\r\n\r\n            devoryGamesContent.innerHTML = devoryGamesOutput;\r\n\r\n            console.log(\"ccccccccccccc: \" + selectedGamesCategory);\r\n\r\n\r\n\r\n\r\n            if (devorySiteID != \"FDC\") { //for devory sites\r\n\r\n                console.log(\"devory sites only\");\r\n\r\n                topStrap = textMenuGS.topWelcome;\r\n\r\n                if (selectedGamesCategory != \"all\") {\r\n                    topStrap = textMenuGS.categoriesFound;\r\n                }\r\n\r\n                gamesBlockHeader.innerHTML = topStrap.replace(/www.frivsite.com/g, devorySiteName).replace(/9999/g, devoryGamesCounter);\r\n\r\n                if (devoryGamesCounter == 0) {\r\n                    gamesBlockHeader.innerHTML = textMenuGS.sorryNoGames;\r\n                }\r\n\r\n                gamesBlockHeader.scrollIntoView({\r\n                    block: 'start',\r\n                    behavior: 'smooth'\r\n                });\r\n\r\n            }\r\n\r\n\r\n\r\n        } //end devory function\r\n\r\n\r\n        showDevoryGames(\"all\");\r\n\r\n        consoleBreak();\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n        //CHECK URLS\r\n        ////////////\r\n\r\n        function getImageDimensions(imageUrl) {\r\n            return new Promise((resolve, reject) => {\r\n                const img = new Image();\r\n\r\n                img.onload = () => {\r\n                    resolve({\r\n                        width: img.width\r\n                    });\r\n                };\r\n\r\n                img.onerror = (error) => {\r\n                    reject(error);\r\n                };\r\n\r\n                img.src = \"https://\" + window.atob(imageUrl);\r\n            });\r\n        }\r\n\r\n        async function checkImageDimensions() { //async function checkImageDimensions() {\r\n\r\n            console.log(\"£££ starting...\");\r\n            //console.log(\"£££ \" + devoryGamesArray);\r\n\r\n            for (const [gameName, gameURL, imageUrl, expectedWidth, gameDefs] of devoryGamesArray) {\r\n\r\n                //console.log(\"£££ loop begin...\");\r\n\r\n                // Skip blank URLs\r\n                if (!imageUrl) {\r\n                    //console.log(`£££ Skipping blank URL for ${ gameName }`);\r\n                    continue;\r\n                }\r\n\r\n                try {\r\n                    const dimensions = await getImageDimensions(imageUrl);\r\n                    const actualWidth = dimensions.width;\r\n                    const color = actualWidth === expectedWidth ? \"lime\" : \"orange\";\r\n\r\n                    console.log(`£££ Game: ${window.atob(gameName)} `);\r\n                    console.log(`£££ Expected Width: ${expectedWidth} `);\r\n                    console.log(`£££ Actual Width: ${actualWidth} (color: ${color})`);\r\n\r\n                    // Update monitorOutputDiv (assuming you have an element with ID \"monitorOutputDiv\")\r\n                    monitorOutputDiv.innerHTML += `< span class=\"${color}\" > ${window.atob(gameName)} <span>`;\r\n                } catch (error) {\r\n                    console.error(`£££ Error loading image: ${imageUrl}`, error);\r\n                    //monitorOutputDiv.innerHTML += `<span class=\"red\">${window.atob(gameName)} FAIL / 404: ${imageUrl}<span> `;\r\n                    monitorOutputDiv.innerHTML += `<span class=\"red\">404-FAIL: ${window.atob(gameName)}<span>`;\r\n                }\r\n\r\n                monitorOutputDiv.innerHTML += `<span class=\"green\">  - - - </span>`;\r\n            }\r\n        }\r\n\r\n\r\n\r\n\r\n\r\n        function checkAllImages() {\r\n\r\n            document.body.innerHTML = \"<div id=monitorOutputDiv></div>\";\r\n            document.documentElement.style.height = '100%';\r\n            document.body.style.height = '100%';\r\n            document.body.style.backgroundImage = 'none';\r\n            document.body.style.backgroundColor = \"#003300\";\r\n\r\n            checkImageDimensions();\r\n\r\n        }\r\n\r\n\r\n\r\n\r\n        console.log(\"=== devory.js END\");\r\n\r\n        //test categories\r\n        //setTimeout(function() {\r\n        //    showDevoryGames(\"#sport\");\r\n        //}, 1000);\r\n\r\n        /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n        /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n        /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n\r\n        //DEVORY END\r\n        /////////////\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n        //DESKTOP PROMO\r\n        ///////////////\r\n\r\n        //if (touchDevice && shortLang == \"en\") {\r\n\r\n        if (false) {\r\n            desktopPrmo.style.display = \"block\";\r\n        }\r\n\r\n        //SCHOOL SPECIFIC\r\n        /////////////////\r\n\r\n        var schoolTime = false;\r\n        if ((hour > 13 && hour < 17) && (day > 0 && day < 6) && (month < 6 || month > 7)) { //afternoons, mon-fri, not july and august (for more educational stuff)\r\n            schoolTime = true;\r\n        }\r\n\r\n        //SITES PROMOTION\r\n        /////////////////\r\n\r\n        const promoSites = [\r\n            [\"frivace.com\", gestureType + \" Here For Friv Ace\"], //More Games\r\n            [\"frivmax.com\", gestureType + \" Here For Friv Max\"],\r\n            [\"frivextra.com\", gestureType + \" Here For Friv Extra\"],\r\n            [\"frivplus.com\", gestureType + \" Here For Friv Plus\"],\r\n            [\"morefriv.com\", gestureType + \" Here For More Friv\"],\r\n            [\"friv.tr\", \"Daha harika oyunlar: friv.tr\"]\r\n        ];\r\n\r\n        //if (!isSchool && gamePlays > 3 && (day == 6 || day == 2)) { //sat-tues\r\n        if (false) { //disabled for now\r\n\r\n            var chosenSite = Math.floor(userRandom / 20); //integers 0 - 4;\r\n\r\n            if (shortLang == \"tr\") {\r\n                chosenSite = 5;\r\n            }\r\n\r\n            topPromoButtonsContainer.style.display = \"block\";\r\n            topPromoButtonsContainer.style.fontSize = \"3vmin\";\r\n\r\n            //topPromoButton1.style.animationPlayState = \"running\";\r\n            topPromoButton1.style.color = \"gold\";\r\n\r\n            topPromoButton1.innerText = promoSites[chosenSite][1];\r\n\r\n            topPromoButton1.addEventListener('click', function (e) {\r\n                window.location.assign(\"https://www.\" + promoSites[chosenSite][0]);\r\n            });\r\n\r\n        }\r\n\r\n        //BREAKPOINT\r\n        ////////////\r\n        if (breakPoint) {\r\n            gtag('event', 'Breakpoint 17', {\r\n                'event_category': 'Debug',\r\n                'event_label': 'Breakpoints'\r\n            });\r\n        }\r\n        ////////////\r\n        ////////////\r\n\r\n\r\n        //INACTIVE TITLE CHANGER\r\n        ////////////////////////\r\n        var defaultTitlesCounter = -15;\r\n        var titlesCounter = defaultTitlesCounter;\r\n\r\n        if (debug) {\r\n            titlesCounter = -1;\r\n        }\r\n\r\n        var chosenTitles = 0;\r\n        var tilesSequenceStarted = false;\r\n        var frivTitle = \"Friv®\";\r\n        var titlePrefix = \"\";\r\n\r\n        if (isSchool) {\r\n            frivTitle = \"Friv4School\";\r\n        }\r\n\r\n        var documentTitlesArray =\r\n\r\n            [\r\n                [\"😃⏩💩⏩⏩⏩😲\", \"😃⏩⏩💩⏩⏩😲\", \"😃⏩⏩⏩💩⏩😲\", \"😃⏩⏩⏩⏩💩😲\", \"😲⏪⏪⏪💩⏪😃\", \"😲⏪⏪💩⏪⏪😃\", \"😲⏪💩⏪⏪⏪😃\", \"😲💩⏪⏪⏪⏪😃\"],\r\n\r\n                [\"😢 I'm kinda lonely!\", \"😃 You there?!\", \"😃 Please play with me!\", \"😳 Come back!\", \"🙂 Please?!\", \"🙂 Pretty please?!\", \"🙂 Pretty pretty please?!\", \"🙂 With sugar on top..?\", \"😲 Hellooooooo!\", \"😃 You still there?\", \"😃 No problem.\", \"😃 It's OK.\", \"😃 I can just...\", \"🥳 ...entertain myself!\", \"😃 Maybe play soccer.\", \"🤠 Dress up a bit.\", \"😜 Stick my tongue out.\", \"😌 Have a nap.\", \"😃 Play some tunes.\", \"😃 Do some star jumps.\", \"😣 I always struggle...\", \"😣 ...with those star jumps.\", \"😃 Heh. Guess what...\", \"😃 My mummy always says...\", \"😃 ...that when I grow up...\", \"😃 ...I could be...\", \"😃 ...an actor!\", \"😃 I'm quite chatty.\", \"😃 And enthusiastic.\", \"😃 And I can always...\", \"😃 ...remember my lines ...\", \"😃 ...in the school play.\", \"😃 She beams and says...\", \"😃 ...I can show a really...\", \"😆 ...wide range of emotions.\", \"🥰 I love my mummy.\", \"😃 Anyway, don't worry.\", \"😃 I'll be right here...\", \"😃 ...when you get back.\", \"😃 ...\", \"😃 Heh. Did you...\", \"😃 ...ever wonder...\", \"😃 ...what it's like...\", \"😃 ...to be an emoji?\", \"😃 Personally I like it.\", \"😃 Lots of chill time.\", \"😃 Plenty of friends.\", \"😃 To be honest...\", \"😃 ...I try to avoid...\", \"😡 ...the angry ones...\", \"😃 ...and stay upwind...\", \"😃 ...of the poo...\", \"😃 ...but there are...\", \"😃 ...lots of nice...\", \"😃 ...animals to cuddle...\", \"😃 ...sports to play...\", \"😃 ...musical instruments...\", \"😃 ...holiday destinations...\", \"😃 ...and all the...\", \"😃 ...fast food...\", \"😃 ...you can eat!\", \"😃 To be frank...\", \"😵 ...I'm surprised...\", \"🤓 ...you're still reading...\", \"😃 ...this stuff because...\", \"😃 ...the games...\", \"😃 ...really are...\", \"😃 ...way more fun!\", \"😃 Once my sister and I...\", \"😃 ...were in the bath...\", \"😃 ...after making mud pies...\", \"😃 ...in the garden...\", \"😃 ...and she said that...\", \"😃 ...I had...\", \"😃 \\\"Verbal Diarrhoea\\\"\", \"😃 ...but because I had...\", \"😃 ...water in my ears...\", \"😃 ...I thought she said...\", \"😃 \\\"Purple Diarrhoea!\\\"\", \"😂 That made me laugh...\", \"😃 ...so hard, some...\", \"😃 ...sick came out of...\", \"😂 ...my nose!\", \"🥰 I love my sister.\", \"🥰 And bath times.\", \"😃 Actually the world...\", \"😃 ...needs more love.\", \"😁 I like to spread it.\", \"😃 So here's a kiss...\", \"😘 ...just for you!\", \"😇 Peace!\", \"😃 Heh. You know...\", \"😃 ...I don't want...\", \"🥰 ...to pour my heart out...\", \"😃 ...or anything...\", \"😃 ...but I think...\", \"😃 ...that maybe...\"],\r\n\r\n                [\"😃 Wow!\", \"😃 I'm sure that...\", \"😃 ...you've been...\", \"😃 ...doing great on...\", \"😃 ...these games.\", \"😃 It looks like you’re...\", \"😃 ...taking a break for...\", \"😃 ...a minute or..\", \"😃 ...two though.\", \"😊 That’s cool.\", \"😃 I was just taking...\", \"😃 ...a toilet break.\", \"😃 Sorry. That’s...\", \"😃 ...probably too...\", \"😊 ...much information.\", \"😃 But I’m back now.\", \"😃 You’re so lucky...\", \"😃 ...you don’t live...\", \"😃 ...with my sister.\", \"😃 Whenever she does...\", \"😃 ...some plops...\", \"😃 ...in the toilet...\", \"😃 ...before flushing...\", \"😃 ...she looks at them...\", \"😃 ...and waves...\", \"😃 ...and says cheerfully...\", \"😃 \\\"See ya later!\\\"\", \"😃 But I really hope...\", \"😃 ...we don’t ever...\", \"😃 ...see them later.\", \"🤮 That would be horrid.\", \"😃 She’s six and...\", \"😃 ...a half now...\", \"😃 ...and there would...\", \"😃 ...be a lot of them. 💩💩💩\", \"😃 Actually, when I...\", \"😃 ...said I was taking...\", \"😃 ...a toilet break...\", \"😃 ...I was kinda lying.\", \"😇 Because I’m little...\", \"😃 ...I mostly still...\", \"😃 ...use my potty.\", \"😃 I had to use...\", \"😃 ...the other sink...\", \"😃 ...to wash my hands...\", \"😃 ...because my daddy...\", \"😃 ...was trying to...\", \"😃 ...unblock the sink...\", \"😃 ...in the bathroom.\", \"😃 I saw him pouring...\", \"😃 ...some bright blue...\", \"😃 ...liquid down it.\", \"😃 He said it would...\", \"😃 ...dissolve whatever was...\", \"😃 ...down there causing...\", \"😃 ...the blockage.\", \"😃 That stuff...\", \"😮 ...is amazing!\", \"😃 Because I must...\", \"😃 ...have dropped...\", \"😃 ...at least four...\", \"😃 ...toothbrushes...\", \"😃 ...down there.\", \"😃 I always brush...\", \"😃 ...twice a day...\", \"😃 ...and I don’t eat...\", \"😃 ...many sugary things.\", \"😃 That’s why...\", \"😃 ...my teeth are...\", \"😁 ...so white and...\", \"😃 ...I don’t have...\", \"😃 ...any fillings.\", \"😃 Actually, my daddy...\", \"😃 ...is usually the...\", \"😃 ...one in our family...\", \"😃 ...who cleans things.\", \"😃  One time he...\", \"😃 ...had to clean...\", \"😃 ...my mummy’s phone...\", \"😃 ...after she said...\", \"😃 ...it went in my potty.\", \"😃 I didn’t know...\", \"😃 ...that phones...\", \"😃 ...needed to go.\", \"😃 Really, I think...\", \"😃 ...we should all...\", \"😃 ...have our own...\", \"😃 ...personal potties.\", \"😃 By the way...\", \"😃 ...do you think that...\", \"😃 ...I chat too much?\", \"😃 Some people say...\", \"😃 ...I should be...\", \"😃 ...on the radio.\", \"😃 Or maybe...\", \"😃 ...on the stage!\", \"😃 I can tell you...\", \"😃 ...about that...\", \"😃 ...another time...\", \"😃 ...but right now...\", \"😃 ...I should like to...\", \"🥳 ...warmly congratulate...\", \"😃 ...you and say...\"],\r\n\r\n                [\"😃 Greetings! \", \"😃 I saw that...\", \"😃 ...you had stopped...\", \"😃 ...playing on Friv...\", \"😃 ...and I thought you...\", \"😃 ...would probably be...\", \"☹️ ...quite lonely now...\", \"😃 ...and would maybe...\", \"😃 ...like a little...\", \"😃 chit chat.\", \"😃 From me.\", \"😃 Definitely.\", \"😃 You see...\", \"😃 ...that’s mostly what...\", \"😃 ...I like to do.\", \"😃 My sister...\", \"😃 ...complains that I...\", \"😃 ...never listen to her...\", \"😃 ...or something...\", \"😃 ...like that.\", \"😃 In fact...\", \"😃 ...when I grow up...\", \"😃 ...I want to be...\", \"😃 ...on stage!\", \"😃 I would be great...\", \"😃 ...up there...\", \"😃 ...in the lights!\", \"😃 I have been a...\", \"😃 ...happy chatty emoji...\", \"😃 ...all my life...\", \"😃 ...and by now I...\", \"😃 ...feel I'm pretty...\", \"😃 ...good at it.\", \"😃 So my next...\", \"😃 ...challenge is...\", \"😃 ...to be a comedian!\", \"😃 I have already...\", \"😃 ...put together a...\", \"😃 ...little routine.\", \"😃 It would REALLY help...\", \"😃 ...if I could try...\", \"😃 ...some of the jokes...\", \"😃 ...out on you.\", \"😃 Is that ok?\", \"😃 Please?\", \"😃 I’ll take your...\", \"😃 ...silence to be...\", \"😃 ...a yes.\", \"😃 Here goes...\", \"😃 \\\"Yesterday, I...\", \"😃 ...told one of my...\", \"😃 ...emoji friends...\", \"😃 ...that her eyebrows...\", \"😃 ...had been drawn...\", \"😃 ...too high.\", \"😃 She looked surprised!\\\"\", \"😁 Ha ha ha!\", \"😃 Get it?!\", \"😃 Next one...\", \"😃 \\\"One time when...\", \"😃 ...I was bored...\", \"😃 ...I put my mummy's...\", \"😃 ...phone on...\", \"😃 ...airplane mode...\", \"😃 ...but it didn't fly.\", \"😃 Must be something...\", \"😃 ...wrong with it!\\\"\", \"😁 Brilliant!\", \"😃 \\\"My sister has...\", \"😃 ...a great deal...\", \"😃 ...of willpower...\", \"😃 ...and when she has...\", \"😃 ...to tidy her room...\", \"😃 ...even more...\", \"😃 ...won’t power!\\\"\", \"😁 Boom boom!\", \"😃 \\\"My daddy spent...\", \"😃 ...a lot of time...\", \"🤑 ...and money...\", \"😃 ...childproofing...\", \"😃 ...our house...\", \"😃 ...but my sister and I...\", \"😃 ...still manage... \", \"😃 ...to get in!\\\"\", \"😁 He he!\", \"😃 I told a few of...\", \"😃 ...these jokes...\", \"😃 ...to some of my...\", \"😃 ...emoji friends...\", \"😃 ...in kindergarten.\", \"😃 They mostly laughed...\", \"😃 ...but I guess somehow...\", \"😃 ...what I really...\", \"😃 ...wanted was a...\", \"😃 ...round of applause.\", \"😃 Hands down...\", \"😃 ...that's one of...\", \"😃 ...the biggest issues...\", \"☹️ ...for us emojis.\", \"😃 Gosh!\", \"😃 Where are my...\", \"😃 ...manners?!\", \"😃 I should really...\", \"😃 ...welcome you again...\", \"😃 ...and say...\"],\r\n\r\n                [\"😃 THANK YOU!\", \"😃 Thank you...\", \"😃 ...so much for...\", \"😃 ...keeping me company.\", \"😃 I was getting a...\", \"😃 ...little lonely there.\", \"😃 You see...\", \"😃 ...even though Friv...\", \"😃 ...has millions...\", \"😃 ...of players...\", \"😃 ...I only get to chat...\", \"😃 ...when somebody leaves...\", \"😃 ...their tab idle.\", \"😃 I’m so glad...\", \"😃 ...that you did!\", \"😃 Now I can tell you...\", \"😃 ...all about my day!\", \"😃 So in the morning...\", \"🤓 ...I was reading...\", \"😃 ...a very grown up book...\", \"😃 ...with long words...\", \"😃 ...and everything.\", \"😃 It’s about a bear...\", \"😃 ...who lives with...\", \"😃 ...his animal friends...\", \"😃 ...in the woods.\", \"😃 I think maybe...\", \"😃 ...in England.\", \"😃 Anyway...\", \"😃 ...I got to one...\", \"😃 ...tricky word I...\", \"😃 ...didn’t understand.\", \"😃 My mummy is quite...\", \"😓 ...stressed right now...\", \"😃 ...because at work...\", \"😃 ...my daddy has been...\", \"😃 ...missing his...\", \"😃 ...dead lions.\", \"😃 I don’t really know...\", \"😃 ...why he misses them...\", \"😃 ...or even why...\", \"😃 ...he has them...\", \"😃 ...in his office.\", \"🤮 Ewwww!\", \"😃 Anyway...\", \"😃 ...luckily my mummy...\", \"😃 ...always helps me...\", \"😃 ...with my reading books.\", \"😃 I had to ask her...\", \"😃 ...what \\\"metaphor\\\"...\", \"😃 ...meant and she said...\", \"😃 \\\"My life’s a train wreck\\\"\", \"😃 ...and I said...\", \"😃 \\\"I know, but...\", \"😃 ...what’s a metaphor?\\\"\", \"😃 ...but just then...\", \"😃 ...I had to get on...\", \"😃 ...the bus for school...\", \"😃 ...so I never found out.\", \"😃 I looked up...\", \"😃 ...that word in...\", \"😃 ...the dictionary...\", \"😃 ...and I think...\", \"😃 ...I get it now.\", \"😃 Then I asked...\", \"😃 ...the school librarian...\", \"😃 ...where Pooh came from.\", \"😃 She looked at me...\", \"😃 ...kinda puzzled...\", \"😃 ...and told me a...\", \"😃 ...really yucky story...\", \"😃 ...that made me feel...\", \"🤢 ...very sick...\", \"😃 ...and I had to lie down...\", \"😃 ...in the school office...\", \"😑 ...until break time.\", \"😃 I don’t think I’ll...\", \"😃 ...ask her where...\", \"😃 ...Tigger and Piglet...\", \"😃 ...come from.\", \"😃 Anyway I just wanted...\", \"😃 ...to announce that...\", \"😃 ...I really am...\", \"😁 ...very grateful...\", \"😃 ...that I have someone...\", \"😃 ...to talk to.\", \"😃 In actual fact...\", \"😃 ...I would like to say...\"],\r\n\r\n                [\"😃 Bonjour!\", \"😉 What’s up?\", \"😃 Are you finished...\", \"😃 ...playing on...\", \"😃 ...the games?\", \"😃 I hope you’ll...\", \"😃 ...be right back.\", \"😃 Of course you’ll...\", \"😃 ...be back.\", \"😃 Definitely.\", \"😃 For real.\", \"😃 For real, for real.\", \"😃 After all...\", \"😃 I’m an optimist.\", \"😃 Not a pessimist.\", \"😃 I know 100%...\", \"😃 ...you'll be back.\", \"😃 Maybe you’re...\", \"😃 ...just taking...\", \"😃 ...a little break.\", \"😃 Maybe you’re...\", \"😃 ...hungry and are...\", \"😃 ...grabbing a snack.\", \"😃 That’s probably it.\", \"🥴 Rumbly tummy.\", \"😁 Like me!\", \"😃 You know...\", \"😃 ...one good thing...\", \"😃 ...about being...\", \"😃 ...an emoji...\", \"😃 ...is all the...\", \"😃 ...delicious food.\", \"😃 I try to eat...\", \"😃 ...my veggies...\", \"😃 ...of course...\", \"😃 ...but it’s hard not...\", \"😃 ...to sample...\", \"😃 ...quite a few of...\", \"😃 ...those yummy cakes. 🍰\", \"😃 I don’t eat them.\", \"😃 I just taste them.\", \"😃 A lot.\", \"😃 Although I’m...\", \"😃 ...an optimist...\", \"😃 ...I do however always...\", \"😃 ...eat my dessert first.\", \"😃 You see...\", \"😃 ...you never know...\", \"😃 ...when the world’s...\", \"😃 ...going to end.\", \"😃 One time when we...\", \"😃 ...were on vacation...\", \"😃 ...in Canada...\", \"😃 ...we went to...\", \"😃 ...a special restaurant...\", \"😃 ...called...\", \"😃 Pie Heaven.\", \"😃 They have soooo...\", \"😃 ...many pies!\", \"😃 You know what's IN...\", \"😃 ...each pie because...\", \"😃 ...of the name.\", \"😃 They had apple pie...\", \"😃 ...cherry pie...\", \"😃 ...even banana pie!\", \"😍 I tried and loved...\", \"😃 ...all of those.\", \"😃 Delicious!\", \"😃 I didn’t try...\", \"😃 ...the shepherds pie...\", \"😃 ...because it sounded...\", \"😃 ...kinda disgusting...\", \"😃 ...what they put...\", \"😃 ...in that one.\", \"😃 In fact...\", \"😃 ...my emoji family...\", \"😃 ...is mostly on a...\", \"😃 ...plant-based diet now.\", \"😃 I’m a VEGetarian.\", \"😃 ...we eat veggies!\", \"😃 Did I ever tell you...\", \"😃 ...that this one time...\", \"😃 ...I was a shepherd...\", \"😃 ...in our school play?\", \"😃 I think it was...\", \"😃 ...at Christmas...\", \"😃 ...or maybe Easter.\", \"😃 Anyway, officially...\", \"☹️ I had been given a...\", \"🤫 ...non-speaking part...\", \"😃 ...because my teacher...\", \"😃 ...said that I had had...\", \"😃 ...quite lot to say...\", \"😃 ...in the play before.\", \"😆 I chatted...\", \"😃 ...away very happily...\", \"😃 ...to the baby Jesus...\", \"😃 ...before the lights...\", \"😃 ...went down...\", \"😃 ...and Mrs. Mahboobeh...\", \"😃 ...used another shepherd’s...\", \"😃 ...stick to assist me...\", \"😃 ...off the stage.\", \"😃 I love Mrs. Mahboobeh.\", \"🤓 She teaches us French.\", \"😃 \\\"Un deux trois!\\\"\", \"😃 For her holidays...\", \"😃 ...she goes to a...\", \"😃 ...poor country called...\", \"😃 ...Papua New Guinea...\", \"😃 ...to be a humanitarian...\", \"😃 ...which does seem...\", \"😃 ...a bit wrong to me.\", \"😃 I’m going to stick...\", \"😃 ...with being a vegetarian.\", \"😃 Once on our holidays...\", \"😃 ...we went to a city..\", \"😃 ...called Regina...\", \"😃 ...which everyone in...\", \"😃 ...my family thought...\", \"😃 ...was pretty funny...\", \"😃 ...because its sounds...\", \"😃 ...exactly like...\", \"😃 ...Angina.\", \"😲 !?!\", \"😃 That was something...\", \"😃 ...my grandma had...\", \"😃 ...in hospital.\", \"😃 She’s better now.\", \"😃 She does marathons!\", \"😃 Oh my goodness.\", \"😃 If Mrs. M were here...\", \"😃 ...she would probably...\", \"😃 ...tell me to have...\", \"😃 ...a rest from talking...\", \"😃 ...or my jaw bones...\", \"😃 ...might wear out...\", \"😍 ...but I just love...\", \"😃 ...to say stuff like...\"],\r\n\r\n                [\"😁 Hello there!\", \"😃 How are you doing?\", \"😃 It looks like...\", \"😃 ...you’re not playing...\", \"😢 ...on Friv right now.\", \"😉 That’s ok.\", \"😃 Good actually.\", \"😃 In fact my mummy...\", \"😃 ...has been limiting...\", \"😃 ...my screen time lately.\", \"😃 Yesterday, when I...\", \"😃 ...had been on my...\", \"😃 ...tablet for quite...\", \"😃 ...a long time...\", \"😃 ...and she had been...\", \"😃 ...nagging me...\", \"😃 ...for ages...\", \"😃 ...she said in her...\", \"😃 ...loud cross voice...\", \"😫 \\\"I’m only going...\", \"😩 ...to ask you...\", \"😫 ...ONE more time!\\\"\", \"😃 Which was good really...\", \"😃 ...as she had already...\", \"🤣 ...asked me a lot!\", \"😃 Don’t worry.\", \"😃 I absolutely...\", \"🥰 ...love my mummy...\", \"😃 ...and I'm mostly...\", \"😇 ...very good.\", \"😃 Problem is...\", \"😃 ...she’s right...\", \"😃 ...and sometimes I...\", \"😃 ...do just stare...\", \"😃 ...at the screen...\", \"😃 ...for so long...\", \"😵 ...my eyes go funny.\", \"😃 Also, my friend says...\", \"😃 ...that I shouldn’t use...\", \"😃 ...an iPad because...\", \"😃 ...the company that...\", \"😃 ...makes them...\", \"😃 ...only pays...\", \"😃 ...their taxis in...\", \"😃 ...Ireland and not...\", \"😃 ...where we live.\", \"😃 I think Apple should...\", \"😃 ...pay their taxis...\", \"😃 ...everywhere as the...\", \"😃 ...poor drivers probably...\", \"😃 ...have kids to feed.\", \"😃 My sister says that...\", \"😃 ...if we were allowed...\", \"😃 ...to have a kitten...\", \"😃 ...then she would go...\", \"😃 ...on the computer...\", \"😃 ...a lot less.\", \"😃 Our daddy says...\", \"🤒 ...he’s allergic...\", \"😃 \\\"Can’t even be in...\", \"😃 ...the same house.\\\"\", \"😃 ...he tells us.\", \"😃 We suggested he could...\", \"😃 ...sleep outside.\", \"😃 Oh wait.\", \"😃 Sorry.\", \"😃 I should probably...\", \"😶 ...shut up now and...\", \"😃 ...let you get back...\", \"😃 ...to whatever thing...\", \"😃 ...you were doing.\", \"😃 I’ll stop now...\", \"🤫 ...and be quiet.\", \"😃 For sure.\", \"😃 And for definite.\", \"😉 100%\", \"😃 Bye!!!\", \"🥴 ...\", \"🤐 ...\", \"😃 Actually it’s better...\", \"😃 ...that I rest a bit.\", \"😃 Because I’m only...\", \"😃 ...a little emoji...\", \"😃 ...my mummy says that...\", \"😃 ...if I don’t have a...\", \"🥱 ...nap in the middle...\", \"😃 ...of the day...\", \"😃 ...I get grouchy.\", \"😩 That’s soooo not true!\", \"😫 Grrr! I hate it...\", \"😃 ...when she says that!\", \"🥱 ...\", \"😌 z\", \"😴 zz\", \"😴 zzz\", \"😴 ZZZ\", \"😌 ...\", \"😁 Hello!\", \"😃 I’m back!\", \"😃 I did have a tiny rest...\", \"😃 ...but I didn’t sleep.\", \"😃 If you saw that...\", \"😃 ...my eyes were closed...\", \"😃 ...that was just me...\", \"😑 ...having a long blink.\", \"😃 Oh gosh.\", \"😃 My sister is...\", \"😃 ...calling me now.\", \"😃 So I’d better go...\", \"😃 ...but in a second...\", \"😃 ...I’ll be back to say...\"]\r\n\r\n                //[\"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \", \"😃 \"],\r\n\r\n            ];\r\n\r\n\r\n\r\n        //select random script\r\n\r\n        function chooseTitles() {\r\n\r\n            chosenTitles = Math.floor(Math.random() * documentTitlesArray.length);\r\n\r\n            if (debug) {\r\n                //chosenTitles = 2;\r\n                //shortLang = \"es\";\r\n            }\r\n\r\n            if (shortLang != \"en\") {\r\n                titlePrefix = \"FRIV: \";\r\n                chosenTitles = 0;\r\n            }\r\n\r\n            //console.log(\"chosenTitles: \" + chosenTitles);\r\n        }\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n        setInterval(function () { //checkDocumentFocus\r\n\r\n            //console.log(\"checkDocumentFocus\");\r\n            //console.log(\"Titles Counter: \" + titlesCounter);\r\n\r\n            if (document.hasFocus()) {\r\n\r\n                //console.log(\"hasFocus\");\r\n\r\n                chooseTitles();\r\n\r\n                titlesCounter = defaultTitlesCounter;\r\n\r\n                if (debug) {\r\n                    titlesCounter = -1;\r\n                }\r\n\r\n                if (tilesSequenceStarted) {\r\n                    document.title = frivTitle;\r\n                }\r\n            } else { //not focussed\r\n\r\n                //console.log(\"does not have focus ... \" + shortLang);\r\n\r\n                if (titlesCounter < documentTitlesArray[chosenTitles].length - 1) {\r\n                    titlesCounter++;\r\n                } else {\r\n                    titlesCounter = 0;\r\n                    if (shortLang == \"en\" && Math.random() < 0.01) {\r\n                        gtag('event', 'Emoji Chat Full En Cycle 1%', {\r\n                            'event_category': 'Bonus Content',\r\n                            'event_label': 'Easter Egg'\r\n                        });\r\n                    }\r\n                }\r\n                if (titlesCounter >= 0) {\r\n                    tilesSequenceStarted = true;\r\n                    document.title = titlePrefix + documentTitlesArray[chosenTitles][titlesCounter];\r\n                }\r\n            }\r\n        }, 2500);\r\n\r\n        document.onmousemove = function () {\r\n            titlesCounter = defaultTitlesCounter;\r\n            if (tilesSequenceStarted) {\r\n                document.title = frivTitle;\r\n            }\r\n        }\r\n\r\n        //FRIV TIPS\r\n        ///////////////////\r\n        if (shortLang == \"en\" && ((pageViews > 17 && pageViews < 23) || (pageViews > 52 && pageViews < 58)) && !isSchool) {\r\n\r\n            frivTips.style.display = \"block\";\r\n\r\n            var frivTipsClickText = \"click\";\r\n            var frivTipsArray = [\r\n                \"Now that games are made using HTML5 technology you can actually play many of them on your phone or tablet too. Just open your mobile browser and enter 'friv.com' ...see you there!\",\r\n                \"When Friv started in 2006 there was no such thing as a 'smartphone' and people mostly played games on their desktop computers at home. The world has changed; now a lot of people visit Friv on their phones and tablets from home, school, work and even while travelling!\",\r\n                \"The games on Friv play in full screen mode. That means that we use all of your screen for the action, and don't place any distractions or ads around the games. If you want our lovely menu to be in full screen mode too, press F11 on your keyboard. Remember to press it again to get your browser back to normal!\",\r\n                //\r\n                \"At Friv we try to keep the number of adverts we show to the absolute minimum - to make playing games better for you! We'll NEVER interrupt your game with an ad or make you sit through a video. That would be rude.\",\r\n                \"There are some games you will only find on Friv and nowhere else, like Smiling Glass Pro Pourer and Crazy Candy Creator. We made them specially for you!\",\r\n                \"Secret: If you click on the Friv logo at the top of the page, you will hear our menu music. Click on it 10 times you'll get extra games!\",\r\n                \"Friv was started after we saw how bad it was for kids trying to play online games at school. Nothing but endless ads and links that went nowhere. We knew we could do better. Friv is now popular with players of all ages.\",\r\n                \"At Friv we don't have much money for advertising, so we ask on our players to spread the word. Thank you!\",\r\n                \"Back in 2006, the main reason we used the made up word 'Friv' was because we thought it would be easy to type and remember. Around the world people pronounce it in VERY different ways. Freev-eh!\",\r\n                \"There is actually a special Friv site for schools - but anyone can use it. At www.friv4school.com there are less of the shooting and dressup games, but more fun puzzle games. Try it!\",\r\n                \"The Friv logo at the top of the page is a vector image. It's not stored as dots or 'pixels' but as mathematical lines. It means that no matter how big your screen is, the logo will always stay sharp.\",\r\n                \"We didn't need to buy any expensive software or fancy computers to make Friv. Anyone can learn to code for free. Just search for 'HTML tutorial' on YouTube - it's a great place to start.\",\r\n                \"The quickest way to get to Friv is to simply type 'friv.com' into your address bar. It's faster and more reliable than using a search engine.\",\r\n                \"One day we found some old Victorian story books in a dusty leather suitcase. Some of them were so good we read them out for you as bedtime stories - find them in 'Friv Daily' at the bottom of the page.\",\r\n                \"When you click on a game below, your computer sends a request to our servers to send the game to you. The information travels as beams of light along fibre optic cables under the sea. But the light can only travel about 50 miles / 70 kilometres or so before it becomes too faint, so there are amplifiers called 'repeaters' dotted all the way along the thousands of miles of cables to keep the data flowing!\",\r\n                \"Once you have played a certain number of games you will see a poo emoji at the <i>bottom</i> of this page. Mostly he likes to sleep. If you click on him, he, well - let's just say he's been clicked on literally MILLIONS of times!\",\r\n                \"Lots of families around the world have no computers at all, or maybe just one basic phone or tablet. We work really hard to make Friv run well even on smaller or slower machines.\",\r\n                \"If someday you want to learn how to make games yourself, you could study computer programming, and hopefully mathematics too. But don't forget art, music and design - they make games come alive!\",\r\n                \"Since we started Friv, literally hundreds of fake Friv sites have appeared, many even ripping off our logo. Thank you, and well done for choosing the real Friv. Accept no imitations!\",\r\n                \"We want the games on Friv to be suitable for all ages, and that's why you won't find swearing in any of them.\",\r\n                \"Most of the games on Friv aren't made by big companies. A typical game is made by just one or two people, often working from home. Many are made for love rather than money, and we think it shows!\",\r\n                \"In the early days of video games, computers were slow and didn't have much memory. Often, they could only display 4 or 8 colours on the screen at once. Now computers can display 16,777,216 colours on the screen at once!\",\r\n                \"We think that playing games should be free for everyone, and we get upset when users elsewhere are overcharged for upgrades / loot boxes / skins etc. Friv will be free forever, for everyone!\",\r\n                \"If you counted all the hours users spend on Friv, it would add up to thousands of lifetimes. This crazy fact keeps us determined to make the experience the best it can be.\",\r\n                \"In the old days, computer games were programmed in assembly language which looked like [mov r0, r10 | bl 0x51dd4 | movt r0, #152 | cmp r0, r5] and the games would only run on the type of computer they were written on. Nowadays, the games here are written in Javascript and will run on nearly any device with a browser. Hurrah!\",\r\n                \"Friv is popular around the world, but we actually get most hits from Latin America - countries like Peru, Colombia, Mexico and Brazil.\",\r\n                \"A lot of users make videos of themselves playing on Friv, and upload them to YouTube. It's a great way to practice valuable presentation, planning, narration, and multitasking skills. Search for OBS (Open Broadcast Software) to find free software to do it.\",\r\n                \"At Friv we try not to be sexist. That's why from the start we chose purple for our background colour - it's halfway between blue and pink! And we hate racism. That's why wherever there is a person of colour in any of the games, we choose them for the thumbnail image.\",\r\n                \"If you search for '250' on Google you will find Friv. That's because our old Flash menu had 250 games, and people still like to search for that number to get here. Try it!\",\r\n                \"We always try to add two or three new games a week - sometimes more, sometimes less - so keep checking back!\",\r\n            ];\r\n\r\n            if (touchDevice) {\r\n                frivTipsClickText = \"tap\";\r\n                frivTipsArray[0] = \"All the games here work on touch screens, but for some Friv games you need to use a keyboard and mouse. Try Friv on your desktop computer for an even BIGGER selection!\";\r\n                frivTipsArray[1] = \"Congratulations! You may not know it, but you are a tech early-adopter! You are playing games in your mobile browser. No need for the App Store or Google Play!\";\r\n                frivTipsArray[2] = \"The future of playing games is in the mobile browser - that way there are no big corporations deciding what you can play. It's the free and open internet, not just what's allowed in the app stores.\";\r\n                var i;\r\n                for (i = 0; i < frivTipsArray.length; i++) {\r\n                    frivTipsArray[i] = frivTipsArray[i].replace(/click/g, \"tap\");\r\n                    frivTipsArray[i] = frivTipsArray[i].replace(/Click/g, \"Tap\");\r\n                    frivTipsArray[i] = frivTipsArray[i].replace(/taped/g, \"tapped\"); //recursive clicked -> taped -> tapped\r\n                }\r\n            }\r\n\r\n            var frivTipNumber = 0 // Math.floor(Math.random() * frivTipsArray.length);\r\n\r\n            if (frivTipNumber == frivTipsArray.length - 1) { //never choose last friv tip (for analytics)\r\n                frivTipNumber--;\r\n            }\r\n\r\n            displayFrivTip();\r\n        }\r\n\r\n        function displayFrivTip() {\r\n            var chosenFrivTip = frivTipsArray[frivTipNumber];\r\n            frivTips.innerHTML = \"Fascinating Frivolous Fact For Fanatical Friv Fans \" + (frivTipNumber + 1) + \"/\" + (frivTipsArray.length) + \" (\" + frivTipsClickText + \" for next)<br>\" + frivTipsArray[frivTipNumber];\r\n            frivTipNumber++;\r\n            if (frivTipNumber == frivTipsArray.length) {\r\n                frivTipNumber = 0;\r\n                gtag('event', 'Friv Tips Full Cycle', {\r\n                    'event_category': 'Bonus Content',\r\n                    'event_label': 'Easter Egg'\r\n                });\r\n            }\r\n        }\r\n\r\n        frivTips.addEventListener(\"click\", displayFrivTip);\r\n\r\n\r\n        //CHECK AND REPORT HOSTNAMES (currently only 1% sample, specified in analytic config)\r\n        var siteURL = window.location.href;\r\n\r\n        if (siteURL.indexOf(\"https://www.friv.com\") != 0 && siteURL.indexOf(\"https://www.friv4school.com\") != 0) { //none of the recognised hostnames present\r\n            gtag('event', siteURL, {\r\n                'event_category': 'Site URL',\r\n                'event_label': 'Debugging'\r\n            });\r\n        }\r\n\r\n\r\n        //console.log(\"x: \" + navigator.connection);\r\n        //console.log(\"y: \" + navigator.mozConnection);\r\n        //console.log(\"z: \" + navigator.webkitConnection);\r\n\r\n\r\n        //CHECK AND REPORT CONNECTIVITY (currently 'school' only)\r\n        if (isSchool && (navigator.connection || navigator.mozConnection || navigator.webkitConnection)) {\r\n\r\n            console.log('         type: ' + navigator.connection.type);\r\n\r\n            // Effective bandwidth estimate\r\n            console.log('     downlink: ' + navigator.connection.downlink + 'Mb/s');\r\n\r\n            // Effective round-trip time estimate\r\n            console.log('          rtt: ' + navigator.connection.rtt + 'ms');\r\n\r\n            // Upper bound on the downlink speed of the first network hop\r\n            console.log('  downlinkMax: ' + navigator.connection.downlinkMax + 'Mb/s');\r\n\r\n            // Effective connection type determined using a combination of recently observed rtt and downlink values\r\n            console.log('effectiveType: ' + navigator.connection.effectiveType);\r\n\r\n            // True if the user has requested a reduced data usage mode from the user agent\r\n            console.log('     saveData: ' + navigator.connection.saveData);\r\n\r\n            var connectivity = navigator.connection.effectiveType;\r\n\r\n            gtag('event', connectivity, {\r\n                'event_category': 'Connectivity',\r\n                'event_label': 'Debugging'\r\n            });\r\n\r\n            if (androidVersion > 0) {\r\n                gtag('event', androidVersion, {\r\n                    'event_category': 'androidVersion',\r\n                    'event_label': 'Debugging'\r\n                });\r\n            }\r\n\r\n        }\r\n\r\n\r\n        //HOUSE PROMO\r\n        /////////////\r\n        var bannerFGN1 = bannerFGN2 = \"3025-mix01\";\r\n\r\n        var bannerFGNRandom = Math.random();\r\n\r\n        if (gamePlays > 3 && bannerFGNRandom < 0.1) {\r\n            bannerFGN1 = \"fgn-pico8/loader\";\r\n        }\r\n\r\n        if (gamePlays > 3 && bannerFGNRandom > 0.95) {\r\n            bannerFGN2 = \"fgn-pico8/loader\";\r\n        }\r\n\r\n        if (scriptsLoadable && !isSchool && window.location.href.indexOf(\"new.html\") > -1) {\r\n            setTimeout(function () {\r\n                var hp1 = document.getElementById(\"housePrm1\");\r\n                if (window.getComputedStyle(hp1).display != \"none\") {\r\n                    housePrm1.innerHTML = \"<iframe src='z/fgn/\" + bannerFGN1 + \".html' width=300 height=256 frameborder=0 scrolling='no'></iframe>\";\r\n                }\r\n                var hp2 = document.getElementById(\"housePrm2\");\r\n                if (window.getComputedStyle(hp2).display != \"none\") {\r\n                    housePrm2.innerHTML = \"<iframe src='z/fgn/\" + bannerFGN2 + \".html' width=300 height=256 frameborder=0 scrolling='no'></iframe>\";\r\n                }\r\n            }, 1000);\r\n        }\r\n\r\n\r\n        //SCROLL TO LOVE TESTER - e.g. if accessed by external link\r\n        ///////////////////////////////////////////////////////////\r\n        function smoothScrollToLoveTester() {\r\n            if (window.location.href.includes(\"#loveTesterA\")) {\r\n\r\n                const myTimeout = setTimeout(showLoveTester, 1000);\r\n\r\n            }\r\n        }\r\n\r\n        window.onload = smoothScrollToLoveTester;\r\n\r\n\r\n\r\n        //REVIEWS\r\n        /////////\r\n        const reviewsText = {\r\n            //\"en\": \"We hope you enjoy playing the games here at Friv. We’re working really hard every day to bring you the best games we can without interrupting your gameplay with ads. If you or a member of your family is able to, please leave us a review at <a href='https://www.sitejabber.com/online-business-review?url=friv.com' rel='noopener noreferrer'>Sitejabber</a> ...we hope we can earn your stars. You will need an email address. Thank you so much!<br>⭐⭐⭐⭐⭐\",\r\n            \"en\": \"We hope you enjoy playing the games here at Friv. We’re working really hard every day to bring you the best games we can without interrupting your gameplay with ads. If you or a member of your family is able to, please leave us a review at <a href='https://www.trustpilot.com/review/www.friv.com' rel='noopener noreferrer'>Trustpilot</a> ...we hope we can earn your stars. Thank you so much!<br>⭐⭐⭐⭐⭐\", //https://tinyurl.com/frivtp/\r\n            \"es\": \"Esperamos que disfrutes jugando a los juegos aquí en Friv. Estamos trabajando muy duro cada día para ofrecerte los mejores juegos posibles sin interrumpir tu juego con anuncios. Si tú o algún miembro de tu familia puede, por favor déjanos una reseña en <a href='https://es.trustpilot.com/review/www.friv.com' rel='noopener noreferrer'>Trustpilot</a> ...esperamos poder ganarnos tus estrellas. ¡Muchas gracias!<br>⭐⭐⭐⭐⭐\", //https://tinyurl.com/frivtpes\r\n            \"pt\": \"Esperamos que goste de jogar os jogos aqui no Friv. Estamos a trabalhar arduamente todos os dias para lhe trazer os melhores jogos possíveis sem interromper a sua jogabilidade com anúncios. Se você ou algum membro da sua família puder, por favor deixe-nos uma avaliação no <a href='https://pt.trustpilot.com/review/www.friv.com' rel='nofollow noreferrer'>Trustpilot</a> ...esperamos poder ganhar as suas estrelas. Muito obrigado!<br>⭐⭐⭐⭐⭐\", //https://tinyurl.com/frivtppt\r\n            \"fr\": \"Nous espérons que vous apprécierez de jouer aux jeux ici sur Friv. Nous travaillons très dur chaque jour pour vous apporter les meilleurs jeux possibles sans interrompre votre expérience de jeu avec des publicités. Si vous ou un membre de votre famille le pouvez, veuillez nous laisser un avis sur <a href='https://fr.trustpilot.com/review/www.friv.com' rel='noopener noreferrer'>Trustpilot</a> ...nous espérons pouvoir gagner vos étoiles. Merci beaucoup !<br>⭐⭐⭐⭐⭐\", //https://tinyurl.com/frivtpfr\r\n            \"de\": \"Wir hoffen, dass Sie viel Spaß beim Spielen der Spiele hier auf Friv haben. Wir arbeiten jeden Tag sehr hart daran, Ihnen die besten Spiele zu bieten, ohne Ihr Spielerlebnis mit Werbung zu unterbrechen. Wenn Sie oder ein Familienmitglied dazu in der Lage sind, hinterlassen Sie uns bitte eine Bewertung auf <a href='https://de.trustpilot.com/review/www.friv.com' rel='noopener noreferrer'>Trustpilot</a> ...wir hoffen, wir können uns Ihre Sterne verdienen. Vielen Dank!<br>⭐⭐⭐⭐⭐\", //https://tinyurl.com/frivtpde\r\n            \"pl\": \"Mamy nadzieję, że spodoba Ci się granie w gry tutaj na Friv. Codziennie ciężko pracujemy, aby dostarczać Ci najlepsze możliwe gry bez przerywania rozgrywki reklamami. Jeśli Ty lub ktoś z Twojej rodziny może, prosimy zostaw nam opinię na <a href='https://pl.trustpilot.com/review/www.friv.com' rel='noopener noreferrer'>Trustpilot</a> ...mamy nadzieję zasłużyć na Twoje gwiazdki. Dziękujemy bardzo!<br>⭐⭐⭐⭐⭐\", //https://tinyurl.com/frivtppl\r\n        };\r\n\r\n        if (gamePlays > 99 && !isSchool && reviewsText[shortLang]) { //mostly disabled\r\n            siteDescription.innerHTML = reviewsText[shortLang];\r\n        }\r\n\r\n        //DISPLAY ELEMENTS ONLY WHEN USERS SCROLL TO IT\r\n        ///////////////////////////////////////////////\r\n        document.addEventListener('DOMContentLoaded', function () {\r\n            const animatedElements = document.querySelectorAll('.scroll-animate');\r\n\r\n            function isInViewport(element) {\r\n                const rect = element.getBoundingClientRect();\r\n                // Adjust this check if you want the animation to start earlier/later\r\n                return (\r\n                    rect.top <= (window.innerHeight || document.documentElement.clientHeight) * 0.8 // Starts when 80% of element is in view\r\n                );\r\n            }\r\n\r\n            function handleScroll() {\r\n                animatedElements.forEach(element => {\r\n                    // Only process if the element is not already visible\r\n                    if (!element.classList.contains('visible')) {\r\n                        if (isInViewport(element)) {\r\n                            element.classList.add('visible');\r\n                            // If you only want it to appear once, you could do this:\r\n                            // element.dataset.animated = 'true'; // Mark as animated\r\n                        }\r\n                    }\r\n                });\r\n\r\n                // Optional: If you want to stop checking after all elements are visible\r\n                // const allAnimated = Array.from(animatedElements).every(el => el.classList.contains('visible'));\r\n                // if (allAnimated) {\r\n                //     window.removeEventListener('scroll', handleScroll);\r\n                // }\r\n            }\r\n\r\n            // Add scroll event listener\r\n            window.addEventListener('scroll', handleScroll);\r\n\r\n            // Initial check in case elements are already in view on page load\r\n            // This will make them expand immediately if they are visible\r\n            handleScroll();\r\n\r\n            // Re-check on resize in case layout changes\r\n            window.addEventListener('resize', handleScroll);\r\n        });\r\n\r\n\r\n        //MOBILE FRIENDLINESS TEST CHANGES\r\n        //////////////////////////////////\r\n        let deviceAspectRatio = window.innerWidth / window.innerHeight;\r\n\r\n        let scrollLimitReached = false;\r\n\r\n        console.log(\"USER ASPECT RATIO: \" + deviceAspectRatio + \" ... USER VISITS: \" + pageViews);\r\n\r\n        if (deviceAspectRatio > 1 || pageViews > 1) { //is landscape, or we have a repeat user, so load normally\r\n\r\n            console.log(\"Landscape or regular visitor... showing extra...\");\r\n\r\n            showContent();\r\n        } else {\r\n\r\n            console.log(\"Portrait or first time visitor...\");\r\n\r\n            scrollToPlay.style.display = \"block\";\r\n\r\n            let userScroll = 0;\r\n            window.onscroll = (e) => {\r\n                userScroll++;\r\n\r\n                if (!scrollLimitReached && userScroll >= 10) {\r\n                    console.log(\"User has scrolled sufficiently... showing extra...\");\r\n                    showContent();\r\n                    scrollLimitReached = true;\r\n                }\r\n            }\r\n\r\n        }\r\n\r\n        function showContent() {\r\n            scrollToPlay.style.display = \"none\";\r\n            gamesBlock.style.display = \"block\";\r\n        }\r\n\r\n\r\n\r\n        //TEXT LINK PROMO FOR ADBLOCK / OTHER USERS\r\n        ///////////////////////////////////////////\r\n\r\n        //if (gamePlays > 10 && (!scriptsLoadable && !isSchool)) {\r\n        //    topPromoTextLink.style.display = \"block\"; //gamui.com etc.\r\n        //}\r\n\r\n        //if (windows11 && shortLang !== \"en\" && gamePlays > 10 && !isSchool) {\r\n        //    topPromoTextLink.style.display = \"block\";\r\n        //}\r\n\r\n        //if (gamePlays > 10 && !isSchool && shortLang == \"en\" && (hour > 15 && hour < 23)) {\r\n        //    bottomPromoTextLink.style.display = \"block\"; //werty etc.\r\n        //}\r\n\r\n\r\n        //XYZ GAMUI PROMO\r\n        ///////////////////////////////////////////\r\n        document.addEventListener('DOMContentLoaded', () => {\r\n            // Parse current query parameters\r\n            const urlParams = new URLSearchParams(window.location.search);\r\n\r\n            // Check if '?gamui' parameter is present in the URL\r\n            if (urlParams.has('gamui') && (shortLang == \"es\" || false)) {\r\n                setTimeout(() => {\r\n                    showPromoOverlay();\r\n                }, 20000);\r\n            }\r\n        });\r\n\r\n        function showPromoOverlay() {\r\n            const overlay = document.getElementById('promo-overlay');\r\n            if (!overlay) return;\r\n\r\n            // Make the overlay visible\r\n            overlay.classList.add('visible');\r\n            overlay.setAttribute('aria-hidden', 'false');\r\n\r\n            // Handle click event anywhere on the overlay\r\n            overlay.addEventListener('click', handleOverlayClick, { once: true });\r\n        }\r\n\r\n        function handleOverlayClick() {\r\n            const overlay = document.getElementById('promo-overlay');\r\n\r\n            // Launch destination in a new tab\r\n            window.open('https://www.gamui.com', '_blank', 'noopener,noreferrer');\r\n\r\n            // Remove/hide overlay\r\n            if (overlay) {\r\n                overlay.classList.remove('visible');\r\n                overlay.setAttribute('aria-hidden', 'true');\r\n            }\r\n        }\r\n\r\n\r\n\r\n        //FINAL JAVASCRIPT EXECUTION\r\n        ////////////////////////////\r\n        if (Math.random() > 0.99) {\r\n            gtag('event', 'Final Javascript', {\r\n                'event_category': 'Navigation',\r\n                'event_label': 'Debugging'\r\n            });\r\n        }\r\n        userAlert.style.display = \"none\"; //if javascript finishes executing as expected, no alert button will be available for users to click on\r\n\r\n        function pageFullyLoaded() {\r\n            if (os == \"Android\") {\r\n                setTimeout(function () {\r\n                    var head = document.head || document.getElementsByTagName('head')[0];\r\n                    var meta = document.createElement('meta');\r\n                    meta.name = \"viewport\";\r\n                    meta.content = \"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\";\r\n                    head.appendChild(meta);\r\n                }, 10000); //guessed min needed for lthouse (was 5000)\r\n\r\n            }\r\n        }\r\n\r\n        if (runExecutionIssueDetect) {\r\n            var eid2 = document.createElement(\"IMG\");\r\n            eid2.setAttribute(\"src\", \"https://whos.amung.us/swidget/msfolka2w002.gif\");\r\n            eid2.setAttribute(\"id\", \"executionIssueDetectDiv2\");\r\n            document.body.appendChild(eid2);\r\n        }\r\n\r\n    </script>\r\n\r\n\r\n\r\n</body>\r\n\r\n</html>"
